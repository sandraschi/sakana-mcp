# Environment template — copy to `.env` and fill in real values (never commit `.env`).

# Required for Gemini-backed ideation/review paths (AI Scientist v2 client).
GEMINI_API_KEY=

# Semantic Scholar key for literature-heavy workflows (compose warns when blank).
S2_API_KEY=

# Optional overrides (defaults resolve repo-relative, never CWD-dependent).
RESEARCH_VAULT_PATH=./research_vault
AI_SCIENTIST_V2_PATH=./vendor/ai-scientist-v2
